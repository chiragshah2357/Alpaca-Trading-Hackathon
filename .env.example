# Copy to .env and fill in. .env is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────────────
# MODEL SELECTION (README §3) — which model each role uses lives HERE, not
# in code. Swap providers/models freely; the agent code never changes.
# Model ids below are PLACEHOLDERS — confirm exact ids at
# https://huggingface.co/inference/models  (README §13 open item).
# ─────────────────────────────────────────────────────────────────────

# Deep thesis brain — paid HF Inference Provider model (Yugo's ~$100 budget)
THESIS_PROVIDER=huggingface
THESIS_MODEL=deepseek-ai/DeepSeek-V4-Pro
# THESIS_API_KEY=              # optional; else falls back to HF_TOKEN below
THESIS_TEMPERATURE=0.3

# Fast lane — cheap high-frequency steps (headline sentiment). Groq (free) or
# Cerebras. To use Cerebras instead: FAST_PROVIDER=cerebras, FAST_MODEL=gemma-4-31b
FAST_PROVIDER=groq
FAST_MODEL=llama-3.3-70b-versatile
# FAST_API_KEY=               # optional; else falls back to GROQ_API_KEY below
FAST_TEMPERATURE=0.2

# Bull/bear debate judge (optional; omit and it defaults to the thesis model)
# JUDGE_PROVIDER=huggingface
# JUDGE_MODEL=moonshotai/Kimi-K3
# JUDGE_TEMPERATURE=0.0

# ─── Provider keys (used as fallback when {ROLE}_API_KEY is not set) ───
HF_TOKEN=
GROQ_API_KEY=
# GOOGLE_API_KEY=
# CEREBRAS_API_KEY=
# OPENAI_API_KEY=

# ─── Alpaca (added now so env is ready; wired up with the trading layer) ─
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
